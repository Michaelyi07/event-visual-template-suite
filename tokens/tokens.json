      }
    },
    "neutral": {
      "900": { "$type": "color", "$value": "#1C2126", "$description": "titles on light" },
      "700": { "$type": "color", "$value": "#3D444C", "$description": "meta text on light" },
      "500": { "$type": "color", "$value": "#6B7480", "$description": "secondary text, dashed strokes" },
